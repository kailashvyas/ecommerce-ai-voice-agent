# ==============================================================================
# Environment Configuration Template (copy to .env or voice-agent/.env)
# ==============================================================================

# Google Cloud Vertex AI & Google ADK Configuration
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Database Configuration
# Path to SQLite database relative to execution root or backend/products.db
PRODUCTS_DB_PATH=backend/products.db

# Optional: Path to custom SSL Certificate Authority file (e.g., from certifi)
# On macOS, certifi path can be obtained via: python3 -m certifi
# SSL_CERT_FILE=/path/to/cacert.pem
